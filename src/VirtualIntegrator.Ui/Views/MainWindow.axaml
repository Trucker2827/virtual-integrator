<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="VirtualIntegrator.Ui.Views.MainWindow"
        Title="Virtual Integrator"
        Width="1200" Height="800">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project..." />
        <MenuItem Header="_Open..." />
        <Separator />
        <MenuItem Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Network">
        <MenuItem Header="_Scan Devices" />
        <MenuItem Header="_Commission Device..." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" />
      </MenuItem>
    </Menu>
    <TextBlock Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center"
               Text="Virtual Integrator — placeholder shell"
               FontSize="18" Opacity="0.6" />
  </DockPanel>
</Window>
